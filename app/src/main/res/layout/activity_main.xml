<?xml version="1.0" encoding="utf-8"?>
<!--
    Version 2 poster. Left half is the weekly limit. Right half is extra credits.
    The alert number stays in a fixed slot between minus and plus.
    The alert is pinned to the bottom so a short landscape row cannot clip it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/split_bar"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Swipe down anywhere on the poster to refresh. The wheels stay outside this. -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh_swipe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/split_mint"
                android:paddingStart="22dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/percent_alert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:letterSpacing="0.16"
                        android:text="@string/alert_word"
                        android:textAllCaps="true"
                        android:textColor="@color/split_ink"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/percent_minus"
                            android:layout_width="40dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/step_down"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="–"
                            android:textColor="@color/split_ink"
                            android:textSize="28sp"
                            android:visibility="invisible" />

                        <TextView
                            android:id="@+id/percent_value"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:autoSizeMaxTextSize="32sp"
                            android:autoSizeMinTextSize="16sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/split_ink" />

                        <TextView
                            android:id="@+id/percent_plus"
                            android:layout_width="40dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/step_up"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="@color/split_ink"
                            android:textSize="28sp"
                            android:visibility="invisible" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_above="@id/percent_alert"
                    android:layout_alignParentTop="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/example_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.14"
                        android:text="@string/example_mark"
                        android:textAllCaps="true"
                        android:textColor="@color/split_ink"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.12"
                        android:text="@string/weekly_kicker"
                        android:textAllCaps="true"
                        android:textColor="@color/split_ink"
                        android:textSize="12sp" />

                    <!-- Weight lets this number shrink in landscape instead of pushing the alert off. -->
                    <TextView
                        android:id="@+id/hero_percent"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="4dp"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="64sp"
                        android:autoSizeMinTextSize="22sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:contentDescription="@string/refresh_numbers"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:minHeight="36dp"
                        android:textColor="@color/split_ink" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.14"
                        android:text="@string/left_word"
                        android:textAllCaps="true"
                        android:textColor="@color/split_ink"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.14"
                        android:text="@string/resets_word"
                        android:textAllCaps="true"
                        android:textColor="@color/split_ink"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/reset_day"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:textColor="@color/split_ink"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/reset_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/split_ink"
                        android:textSize="15sp" />
                </LinearLayout>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/split_night"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/dollar_alert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:letterSpacing="0.16"
                        android:text="@string/alert_word"
                        android:textAllCaps="true"
                        android:textColor="@color/split_gold"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/dollar_minus"
                            android:layout_width="40dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/step_down"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="–"
                            android:textColor="@color/split_gold"
                            android:textSize="28sp"
                            android:visibility="invisible" />

                        <TextView
                            android:id="@+id/dollar_value"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:autoSizeMaxTextSize="32sp"
                            android:autoSizeMinTextSize="16sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/split_gold" />

                        <TextView
                            android:id="@+id/dollar_plus"
                            android:layout_width="40dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/step_up"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="@color/split_gold"
                            android:textSize="28sp"
                            android:visibility="invisible" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_above="@id/dollar_alert"
                    android:layout_alignParentTop="true"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.12"
                            android:text="@string/extra_kicker"
                            android:textAllCaps="true"
                            android:textColor="@color/split_gold"
                            android:textSize="12sp" />

                        <ImageButton
                            android:id="@+id/theme_button"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/theme_button"
                            android:padding="8dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_moon" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/hero_credits"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="52sp"
                        android:autoSizeMinTextSize="20sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:minHeight="36dp"
                        android:textColor="@color/split_gold" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/split_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/interval_label"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            android:textColor="@color/split_bar_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/battery_button"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="20dp"
            android:text="@string/battery"
            android:textColor="@color/split_bar_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Replaces the bottom bar while a refresh interval is being chosen. -->
    <LinearLayout
        android:id="@+id/interval_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/split_bar"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.14"
                android:text="@string/refresh_word"
                android:textAllCaps="true"
                android:textColor="@color/split_bar_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/sign_out"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:padding="4dp"
                android:text="@string/sign_out"
                android:textColor="@color/split_gold"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Hours and minutes scroll on their own. 00:00 means tap the percent. -->
        <TextView
            android:id="@+id/interval_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/split_bar_text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <NumberPicker
                    android:id="@+id/hour_picker"
                    android:layout_width="96dp"
                    android:layout_height="132dp"
                    android:descendantFocusability="blocksDescendants"
                    android:theme="@style/Widget.CursorLimit.Picker" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/hours_label"
                    android:textAllCaps="true"
                    android:textColor="@color/split_bar_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="132dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text=":"
                android:textColor="@color/split_mint"
                android:textSize="32sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <NumberPicker
                    android:id="@+id/minute_picker"
                    android:layout_width="96dp"
                    android:layout_height="132dp"
                    android:descendantFocusability="blocksDescendants"
                    android:theme="@style/Widget.CursorLimit.Picker" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/minutes_label"
                    android:textAllCaps="true"
                    android:textColor="@color/split_bar_text"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- The sheet hides the bottom bar, so this is the way back. -->
        <TextView
            android:id="@+id/interval_done"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/chip_bg"
            android:backgroundTint="@color/split_mint"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/done"
            android:textColor="@color/split_ink"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
