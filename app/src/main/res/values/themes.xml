<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CursorLimit" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bar</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:statusBarColor">@color/split_bar</item>
        <item name="android:navigationBarColor">@color/split_bar</item>
        <item name="android:windowBackground">@color/split_bar</item>
        <item name="android:textColor">@color/text</item>
        <item name="materialButtonStyle">@style/Widget.CursorLimit.Button</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- One filled action. Corners and height stay the same in both themes. -->
    <style name="Widget.CursorLimit.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/bar</item>
    </style>

    <style name="Widget.CursorLimit.Button.Quiet" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text</item>
        <item name="strokeColor">@color/line</item>
        <item name="backgroundTint">@color/card</item>
    </style>

    <style name="Widget.CursorLimit.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/bar</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>
